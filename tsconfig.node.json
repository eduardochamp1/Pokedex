{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "lib": [
      "ES2023"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "emitDeclarationOnly": true,
    "allowImportingTsExtensions": true,
    "declaration": true,
    "outDir": "./.tsbuild-node",
    "types": [
      "node"
    ],
    "allowJs": true,
    "checkJs": false
  },
  "include": [
    "vite.config.ts",
    "scripts/**/*.mjs",
    "vite-plugin-sw.ts",
    "vite-plugin-sw.test.ts"
  ]
}
